<!doctype html>
<html lang="{{ lang }}" dir="{{ supportedLanguages[lang].dir }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width">

        <title>{{ if title }}{{ title }} | {{ /if }}{{ site[lang].name }}</title>
        {{ include "partials/global/stylesheets.vto" }}
        {{ include "partials/global/meta.vto" }}
        <link rel="alternate" type="application/atom+xml" href="{{ site.en.url }}{{ if locale !== defaultLanguage }}/{{ lang }}{{ /if }}/feed.xml" title="{{ __ 'rss', {site: site[lang].name}, {translations} }}">

        {{ include 'partials/global/icons.vto' }}
        <link rel="manifest" id="manifest">
        <script>
          const language = "{{ lang }}";
          const manifestUrl = `/manifest-${language}.json`;

          document.querySelector("#manifest").setAttribute(
            "href",
            manifestUrl,
          );
        </script>

        {{ include 'partials/global/scripts.vto' }}
    </head>
    <body class="{{ bodyClass ?? "page" }}">
        {{ uioTemplate |> safe }}
        {{ include 'partials/global/header.vto' }}
        <main>
            <article>
                {{ pageHeader }}
                <nav class="flc-toc-tocContainer"></nav>
                <div class="content">
                {{ content |> safe }}
                </div>
            </article>
        </main>
        {{ include 'partials/global/footer.vto' }}
    	{{ uioCustomInit supportedLanguages[lang].uioSlug, supportedLanguages[lang].dir |> safe }}
    </body>
</html>
